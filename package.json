{
  "name": "git-inline-diff",
  "displayName": "Git Inline Diff (Accept / Reject)",
  "description": "Cursor-style review of what changed in the open file compared to GitHub (upstream branch), HEAD or the index. Added lines are green, removed lines are shown in red, and every hunk can be accepted or rejected with a click or a shortcut.",
  "version": "0.5.0",
  "publisher": "Ghammes",
  "author": { "name": "Ghammes" },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "diff",
    "inline",
    "review",
    "accept",
    "reject",
    "cursor"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "enabledApiProposals": [
    "editorInsets"
  ],
  "contributes": {
    "commands": [
      { "command": "gitInlineDiff.acceptHunk", "title": "Accept Hunk (keep my version)", "category": "Git Inline Diff", "icon": "$(check)" },
      { "command": "gitInlineDiff.rejectHunk", "title": "Reject Hunk (take the base / remote version)", "category": "Git Inline Diff", "icon": "$(close)" },
      { "command": "gitInlineDiff.keepBoth", "title": "Accept Both (conflict: insert the remote lines above mine)", "category": "Git Inline Diff", "icon": "$(combine)" },
      { "command": "gitInlineDiff.acceptAll", "title": "Accept All Hunks in File", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.rejectAll", "title": "Reject All Hunks in File (restore base version)", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.nextHunk", "title": "Go to Next Hunk", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.previousHunk", "title": "Go to Previous Hunk", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.openDiff", "title": "Open Diff Against Base", "category": "Git Inline Diff", "icon": "$(git-compare)" },
      { "command": "gitInlineDiff.showBase", "title": "Open Base Version (read-only)", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.reviewAll", "title": "Review All Changed Files Against Base", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.refresh", "title": "Refresh", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.fetchAndRefresh", "title": "Fetch Remote and Refresh", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.resetAccepted", "title": "Show Accepted Hunks Again (this file)", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.chooseBase", "title": "Choose What to Compare Against", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.toggle", "title": "Enable / Disable", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.enableInlineRows", "title": "Enable Inline Rows (proposed API, restart required)", "category": "Git Inline Diff" },
      { "command": "gitInlineDiff.showMenu", "title": "Show Menu", "category": "Git Inline Diff" }
    ],
    "keybindings": [
      { "command": "gitInlineDiff.acceptHunk", "key": "ctrl+shift+y", "mac": "cmd+shift+y", "when": "editorTextFocus && gitInlineDiff.hunkAtCursor" },
      { "command": "gitInlineDiff.rejectHunk", "key": "ctrl+n", "mac": "cmd+n", "when": "editorTextFocus && gitInlineDiff.hunkAtCursor" },
      { "command": "gitInlineDiff.nextHunk", "key": "ctrl+alt+]", "mac": "cmd+alt+]", "when": "editorTextFocus && gitInlineDiff.hasHunks" },
      { "command": "gitInlineDiff.previousHunk", "key": "ctrl+alt+[", "mac": "cmd+alt+[", "when": "editorTextFocus && gitInlineDiff.hasHunks" },
      { "command": "gitInlineDiff.nextHunk", "key": "f7", "when": "editorTextFocus && gitInlineDiff.hasHunks && !isInDiffEditor" },
      { "command": "gitInlineDiff.previousHunk", "key": "shift+f7", "when": "editorTextFocus && gitInlineDiff.hasHunks && !isInDiffEditor" },
      { "command": "gitInlineDiff.openDiff", "key": "ctrl+alt+d", "mac": "cmd+alt+d", "when": "editorTextFocus && gitInlineDiff.hasHunks" }
    ],
    "menus": {
      "editor/title": [
        { "command": "gitInlineDiff.openDiff", "when": "gitInlineDiff.hasHunks && resourceScheme == file", "group": "navigation@1" }
      ],
      "editor/context": [
        { "command": "gitInlineDiff.acceptHunk", "when": "gitInlineDiff.hunkAtCursor", "group": "gitInlineDiff@1" },
        { "command": "gitInlineDiff.rejectHunk", "when": "gitInlineDiff.hunkAtCursor", "group": "gitInlineDiff@2" },
        { "command": "gitInlineDiff.keepBoth", "when": "gitInlineDiff.hunkAtCursor", "group": "gitInlineDiff@2" },
        { "command": "gitInlineDiff.openDiff", "when": "gitInlineDiff.hasHunks", "group": "gitInlineDiff@3" }
      ],
      "commandPalette": [
        { "command": "gitInlineDiff.showMenu", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Git Inline Diff",
      "properties": {
        "gitInlineDiff.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline git changes in every opened file."
        },
        "gitInlineDiff.base": {
          "type": "string",
          "default": "upstream",
          "markdownDescription": "What the open file is compared against.\n\n- `upstream` — the remote tracking branch (what is on GitHub, e.g. `origin/development`). Falls back to `HEAD` when the branch has no upstream.\n- `head` — the last local commit.\n- `index` — the staged version.\n- any other value is used as a git ref, e.g. `origin/main` or `v1.2.0`."
        },
        "gitInlineDiff.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Accept / Reject / Diff CodeLens above every hunk."
        },
        "gitInlineDiff.removedLinesView": {
          "type": "string",
          "enum": ["rows", "inline", "off"],
          "enumDescriptions": [
            "Real rows right above the hunk with the action buttons inside, Cursor style (default). Needs the editorInsets proposed API: run 'Git Inline Diff: Enable Inline Rows' once and restart the editor. Falls back to inline chips + CodeLens until then.",
            "Coloured chips at the end of the changed lines, actions as CodeLens.",
            "Nothing inline; the hover and the diff editor still show the other side."
          ],
          "default": "rows",
          "description": "How the other side's lines (removed / remote) are shown inside the editor."
        },
        "gitInlineDiff.removedTextMaxLength": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "description": "Maximum length of the inline removed text before it is cut with an ellipsis."
        },
        "gitInlineDiff.showGutterIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show green / red bars in the glyph margin next to changed lines."
        },
        "gitInlineDiff.showKeybindingHint": {
          "type": "boolean",
          "default": true,
          "description": "Show 'Reject Ctrl+N · Accept Ctrl+Shift+Y' at the end of the hunk under the cursor."
        },
        "gitInlineDiff.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Ignore leading and trailing whitespace when comparing lines."
        },
        "gitInlineDiff.threeWay": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Classify hunks with the merge base of HEAD and the base ref: **mine** (green, only you changed it), **incoming** (blue, the remote changed it and you have not pulled yet) and **conflict** (orange, both sides changed it). When off, every difference is shown as yours."
        },
        "gitInlineDiff.advanceAfterAction": {
          "type": "boolean",
          "default": true,
          "description": "After Accept or Reject, move the cursor to the next pending hunk."
        },
        "gitInlineDiff.maxLines": {
          "type": "number",
          "default": 20000,
          "description": "Files with more lines than this are skipped."
        },
        "gitInlineDiff.exclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/node_modules/**", "**/package-lock.json", "**/yarn.lock", "**/pnpm-lock.yaml", "**/*.min.js", "**/*.map"],
          "description": "Glob patterns (matched against the absolute path) of files that are never compared."
        }
      }
    },
    "colors": [
      {
        "id": "gitInlineDiff.addedLineBackground",
        "description": "Background of lines that are new or changed compared to the base.",
        "defaults": { "dark": "diffEditor.insertedLineBackground", "light": "diffEditor.insertedLineBackground", "highContrast": "diffEditor.insertedLineBackground", "highContrastLight": "diffEditor.insertedLineBackground" }
      },
      {
        "id": "gitInlineDiff.removedTextBackground",
        "description": "Background of the inline removed (base) text.",
        "defaults": { "dark": "diffEditor.removedTextBackground", "light": "diffEditor.removedTextBackground", "highContrast": "diffEditor.removedTextBackground", "highContrastLight": "diffEditor.removedTextBackground" }
      },
      {
        "id": "gitInlineDiff.removedTextForeground",
        "description": "Foreground of the inline removed (base) text.",
        "defaults": { "dark": "gitDecoration.deletedResourceForeground", "light": "gitDecoration.deletedResourceForeground", "highContrast": "gitDecoration.deletedResourceForeground", "highContrastLight": "gitDecoration.deletedResourceForeground" }
      },
      {
        "id": "gitInlineDiff.removedMarker",
        "description": "Border drawn where base lines were removed without replacement.",
        "defaults": { "dark": "gitDecoration.deletedResourceForeground", "light": "gitDecoration.deletedResourceForeground", "highContrast": "gitDecoration.deletedResourceForeground", "highContrastLight": "gitDecoration.deletedResourceForeground" }
      },
      {
        "id": "gitInlineDiff.hintForeground",
        "description": "Foreground of the keybinding hint shown at the end of the hunk under the cursor.",
        "defaults": { "dark": "editorCodeLens.foreground", "light": "editorCodeLens.foreground", "highContrast": "editorCodeLens.foreground", "highContrastLight": "editorCodeLens.foreground" }
      },
      {
        "id": "gitInlineDiff.incomingLineBackground",
        "description": "Background of lines the remote changed and you have not pulled yet.",
        "defaults": { "dark": "merge.incomingContentBackground", "light": "merge.incomingContentBackground", "highContrast": "merge.incomingContentBackground", "highContrastLight": "merge.incomingContentBackground" }
      },
      {
        "id": "gitInlineDiff.incomingTextBackground",
        "description": "Background of the inline text showing the remote version of an incoming change.",
        "defaults": { "dark": "merge.incomingHeaderBackground", "light": "merge.incomingHeaderBackground", "highContrast": "merge.incomingHeaderBackground", "highContrastLight": "merge.incomingHeaderBackground" }
      },
      {
        "id": "gitInlineDiff.incomingTextForeground",
        "description": "Foreground of the inline text showing the remote version of an incoming change.",
        "defaults": { "dark": "foreground", "light": "foreground", "highContrast": "foreground", "highContrastLight": "foreground" }
      },
      {
        "id": "gitInlineDiff.incomingMarker",
        "description": "Border and overview ruler colour of incoming changes.",
        "defaults": { "dark": "merge.incomingHeaderBackground", "light": "merge.incomingHeaderBackground", "highContrast": "merge.incomingHeaderBackground", "highContrastLight": "merge.incomingHeaderBackground" }
      },
      {
        "id": "gitInlineDiff.conflictLineBackground",
        "description": "Background of lines changed both by you and by the remote since the merge base.",
        "defaults": { "dark": "#9e6a0333", "light": "#f2cc6040", "highContrast": "#9e6a0366", "highContrastLight": "#f2cc6080" }
      },
      {
        "id": "gitInlineDiff.conflictTextBackground",
        "description": "Background of the inline text showing the remote version of a conflicting change.",
        "defaults": { "dark": "#9e6a0380", "light": "#f2cc6099", "highContrast": "#9e6a03b3", "highContrastLight": "#f2cc60cc" }
      },
      {
        "id": "gitInlineDiff.conflictTextForeground",
        "description": "Foreground of the inline text showing the remote version of a conflicting change.",
        "defaults": { "dark": "editorWarning.foreground", "light": "editorWarning.foreground", "highContrast": "editorWarning.foreground", "highContrastLight": "editorWarning.foreground" }
      },
      {
        "id": "gitInlineDiff.conflictMarker",
        "description": "Border and overview ruler colour of conflicting changes.",
        "defaults": { "dark": "editorWarning.foreground", "light": "editorWarning.foreground", "highContrast": "editorWarning.foreground", "highContrastLight": "editorWarning.foreground" }
      }
    ]
  },
  "scripts": {
    "test": "node test/smoke.js",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "diff": "^8.0.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
